{
  "name": "metlife-archivador",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:rules": "firebase emulators:exec --only database --project demo-metlife \"node --test tests/rules/*.test.cjs\"",
    "dev": "firebase emulators:start --only hosting,auth,database --project demo-metlife",
    "backup": "node scripts/backup.cjs",
    "role": "node scripts/set-role.cjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "firebase": "12.6.0",
    "firebase-admin": "13.6.0",
    "firebase-tools": "14.26.0",
    "@firebase/rules-unit-testing": "5.0.0"
  }
}
