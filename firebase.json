{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "server.mjs",
      "shared-records.json",
      "README.md",
      "**/*.log",
      "**/.*",
      "**/node_modules/**",
      "tests/**",
      "docs/**",
      "scripts/**",
      ".qa/**",
      "**/.*/**",
      "ejemplo poliza.jpeg",
      "ejemplos/**",
      "**/ejemplo*",
      "database.rules.json",
      "package*.json",
      "jsconfig.json",
      "eslint.config.mjs",
      "backups/**"
    ],
    "headers": [
      {
        "source": "**/*.@(js|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "database": {
      "port": 9000
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
